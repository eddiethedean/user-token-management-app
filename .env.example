APP_ENV=development
APP_NAME=Access Registry
PUBLIC_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./access-registry.db

# Generate at least 32 random bytes for each secret. Never reuse them across enclaves.
JWT_SECRET=replace-with-a-long-random-secret
SESSION_PEPPER=replace-with-another-long-random-secret
# Reserved configuration: production validation currently requires this value, but the implemented
# synchronizer-token CSRF design does not consume it. See SECURITY.md SD-18 before deployment.
CSRF_SECRET=replace-with-a-third-long-random-secret
JWT_ISSUER=urn:access-registry:local
JWT_AUDIENCE=access-registry-api
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_HOURS=8
SESSION_IDLE_MINUTES=30
COOKIE_SECURE=false
# "auto" scopes cookies to the Connect or Workbench application path at request time.
COOKIE_PATH=auto
# Only list the immediate reverse proxies that overwrite X-Forwarded-For.
TRUSTED_PROXY_IPS=

# Shared database-backed fixed-window limits. Keep ingress throttling as a second layer.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_PER_SOURCE=30
RATE_LIMIT_LOGIN_PER_ACCOUNT=10
RATE_LIMIT_REGISTRATION_PER_SOURCE=10
RATE_LIMIT_REGISTRATION_PER_ACCOUNT=3
RATE_LIMIT_RESET_PER_SOURCE=10
RATE_LIMIT_RESET_PER_ACCOUNT=3

# Invitations and self-registration are restricted to these domains. Leave empty only for local testing.
ALLOWED_EMAIL_DOMAINS=example.gov,example.mil

# Optional eligibility lookup; this is not authentication or identity proofing. The service receives
# GET requests with a `query` parameter and must return the exact email in `email`, `mail`, or a
# supported `attributes` field. Set REQUIRED=true to reject enrollment while it is unavailable.
DIRECTORY_LOOKUP_URL=
DIRECTORY_LOOKUP_TIMEOUT_SECONDS=5
DIRECTORY_LOOKUP_VERIFY_TLS=true
DIRECTORY_LOOKUP_CA_BUNDLE=
DIRECTORY_LOOKUP_REQUIRED=false
DIRECTORY_LOOKUP_BEARER_TOKEN=

# Console prints development email links. SMTP sends through an approved relay.
EMAIL_BACKEND=console
EMAIL_FROM=Access Registry <no-reply@example.gov>
SMTP_HOST=
SMTP_PORT=25
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=

# Use argon2 by default. Consult the system security plan before selecting a FIPS mode.
PASSWORD_HASH_SCHEME=argon2
PBKDF2_ITERATIONS=600000
