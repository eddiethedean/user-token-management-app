# =============================================================================
# Access Registry — environment template
# Copy to .env and adjust. Never commit real secrets.
# =============================================================================

# --- Local minimum (enough for Quick start) ---------------------------------
APP_ENV=development
APP_NAME=Access Registry
PUBLIC_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./access-registry.db

# Generate unique values for anything beyond throwaway local demos, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
SESSION_PEPPER=replace-with-another-long-random-secret
CSRF_SECRET=replace-with-a-third-long-random-secret

# Dev-only AES key material (rejected when APP_ENV=production). Production recipe:
#   python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
API_TOKEN_ENCRYPTION_KEYS={"development-v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
API_TOKEN_ACTIVE_KEY_ID=development-v1

AUTHENTICATION_MODE=local_password
COOKIE_SECURE=false
COOKIE_PATH=auto
ALLOWED_EMAIL_DOMAINS=example.gov,example.mil,socom.mil
EMAIL_BACKEND=console
EMAIL_FROM=Access Registry <no-reply@example.gov>

# --- Full reference (defaults match local; harden for production) -----------

# PostgreSQL (required in production):
# DATABASE_URL=postgresql+psycopg://USER:PASS@HOST:5432/DBNAME
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

API_TOKEN_MAX_WRAPS_PER_KEY=1000000
JWT_ISSUER=urn:access-registry:local
JWT_AUDIENCE=access-registry-api

# Prefer trusted_header behind an approved CAC/MFA identity-aware proxy.
# Local password mode in production requires explicit documented risk acceptance.
PASSWORD_ONLY_PRODUCTION_RISK_ACCEPTED=false
TRUSTED_IDENTITY_HEADER=x-access-registry-user

ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_HOURS=8
SESSION_IDLE_MINUTES=30
# Production requires COOKIE_SECURE=true and HTTPS PUBLIC_BASE_URL.
HSTS_INCLUDE_SUBDOMAINS=false
# Only list immediate reverse proxies whose forwarded client/identity headers the app may trust.
# Posit Connect mount-path discovery does not require this value.
TRUSTED_PROXY_IPS=

# Shared database-backed fixed-window limits. Production refuses RATE_LIMIT_ENABLED=false.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_PER_SOURCE=30
RATE_LIMIT_LOGIN_PER_ACCOUNT=10
RATE_LIMIT_REGISTRATION_PER_SOURCE=10
RATE_LIMIT_REGISTRATION_PER_ACCOUNT=3
RATE_LIMIT_RESET_PER_SOURCE=10
RATE_LIMIT_RESET_PER_ACCOUNT=3

# Optional eligibility lookup (not authentication). GET with `query`; response must include the
# exact email in `email`, `mail`, or a supported `attributes` field.
# Example success JSON shapes:
#   {"email":"user@example.gov"}
#   {"mail":"user@example.gov"}
#   {"attributes":{"mail":["user@example.gov"]}}
# REQUIRED=true also requires a non-empty DIRECTORY_LOOKUP_URL; production requires HTTPS.
DIRECTORY_LOOKUP_URL=
DIRECTORY_LOOKUP_TIMEOUT_SECONDS=5
DIRECTORY_LOOKUP_VERIFY_TLS=true
DIRECTORY_LOOKUP_CA_BUNDLE=
DIRECTORY_LOOKUP_REQUIRED=false
DIRECTORY_LOOKUP_BEARER_TOKEN=

# Console prints development email links. SMTP sends through an approved relay.
EMAIL_REDACT_SENT_BODIES=false
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_SECONDS=30
EMAIL_RETRY_MAX_SECONDS=3600
EMAIL_CLAIM_TIMEOUT_SECONDS=300
SMTP_HOST=
SMTP_PORT=25
SMTP_STARTTLS=true
SMTP_CA_BUNDLE=
SMTP_USERNAME=
SMTP_PASSWORD=

PASSWORD_HASH_SCHEME=argon2
PBKDF2_ITERATIONS=600000
# Production requires an approved offline list with one blocked password per line.
PASSWORD_BLOCKLIST_PATH=

# --- Optional: local Posit Workbench Docker integration tests ---------------
# Trial/eval license key only — never commit the real value. Used by:
#   make workbench-up && make workbench-test
# Maps to the container's PWB_LICENSE. Prefer a license file for long-lived use.
# POSIT_WORKBENCH_KEY=XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX
# PWB_IMAGE=posit/workbench:latest
# PWB_HOST_PORT=8787
# APP_HOST_PORT=8000
# PWB_TESTUSER=posit
# PWB_TESTUSER_PASSWD=Xk9#mQ2$vL8!nR4p
# ADMIN_EMAIL=admin@example.gov
# ADMIN_BOOTSTRAP_PASSWORD=Tr0pic-Maple!River92
