# Data Mover environment template
#
# Copy this file to .env, then edit only the values your deployment needs:
#   cp .env.example .env
#   chmod 600 .env
#
# .env is loaded by the app and by scripts/deploy-connect.sh. Never commit real
# secrets, passwords, tokens, or private connection details.
#
# A short explanation of each group is in docs/configuration.md.

# =============================================================================
# 1) LOCAL DEVELOPMENT — committed defaults are enough for Quick start
# =============================================================================
# Non-sensitive product defaults live in app/config.py. Add an environment
# override only when this deployment intentionally differs from those defaults.
# APP_ENV=development
# PUBLIC_BASE_URL='http://127.0.0.1:8000'
# DATABASE_URL='sqlite:///./access-registry.db'
# DATA_MOVER_MODE=demo

# Deployment policy: replace with the domains users may enroll from.
ALLOWED_EMAIL_DOMAINS='example.gov,example.mil,socom.mil'

# Generate three different values for anything beyond a throwaway local demo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET='replace-with-a-long-random-secret'
SESSION_PEPPER='replace-with-another-long-random-secret'
CSRF_SECRET='replace-with-a-third-long-random-secret'

# Local-only credential encryption key. Production must use a new 32-byte key.
#   python -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
API_TOKEN_ENCRYPTION_KEYS='{"development-v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}'
API_TOKEN_ACTIVE_KEY_ID=development-v1

# AUTHENTICATION_MODE, COOKIE_SECURE, COOKIE_PATH, EMAIL_BACKEND, and
# EMAIL_FROM use the safe local defaults in app/config.py.

# =============================================================================
# 2) PRODUCTION — uncomment and replace the examples; do not use local values
# =============================================================================

# --- Required production identity, database, and secrets --------------------
# APP_ENV=production
# PUBLIC_BASE_URL='https://connect.example.gov/content/DATA-MOVER-ID'
# DATABASE_URL='postgresql+psycopg://USER:URL_ENCODED_PASSWORD@HOST:5432/DBNAME'
# JWT_SECRET='GENERATED_VALUE_1'
# SESSION_PEPPER='GENERATED_VALUE_2'
# CSRF_SECRET='GENERATED_VALUE_3'
# API_TOKEN_ENCRYPTION_KEYS='{"production-v1":"BASE64_32_BYTE_KEY"}'
# API_TOKEN_ACTIVE_KEY_ID=production-v1
# AUTHENTICATION_MODE=local_password
# PASSWORD_ONLY_PRODUCTION_RISK_ACCEPTED=true
# COOKIE_SECURE=true
# COOKIE_PATH=auto
# ALLOWED_EMAIL_DOMAINS='example.gov,example.mil,socom.mil'

# --- Production email (required for invitations and password recovery) -------
# EMAIL_BACKEND=smtp
# EMAIL_REDACT_SENT_BODIES=true
# EMAIL_FROM='Data Mover <no-reply@example.gov>'
# SMTP_HOST='smtp.example.gov'
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USERNAME='service-account'
# SMTP_PASSWORD='REPLACE_WITH_SMTP_PASSWORD'
# SMTP_CA_BUNDLE='deployment/smtp-ca.pem'
#
# SMTP_USE_TLS and SMTP_FROM_EMAIL are accepted compatibility aliases, but the
# canonical names above are preferred for new configuration.

# --- Optional directory eligibility check -----------------------------------
# This is an email eligibility check, not authentication. Enable it only when
# an approved directory endpoint should gate enrollment.
# DIRECTORY_LOOKUP_URL='https://directory.example.gov/api/ldapEmail'
# DIRECTORY_LOOKUP_TIMEOUT_SECONDS=5
# DIRECTORY_LOOKUP_VERIFY_TLS=true
# DIRECTORY_LOOKUP_CA_BUNDLE='deployment/directory-ca.pem'
# DIRECTORY_LOOKUP_BEARER_TOKEN='REPLACE_WITH_DIRECTORY_TOKEN'
# DIRECTORY_LOOKUP_REQUIRED=true
# DIRECTORY_LOOKUP_TIMEOUT_S and DIRECTORY_LOOKUP_VERIFY_SSL are accepted
# compatibility aliases for the two canonical directory settings above.

# --- Live data movement ------------------------------------------------------
# DATA_MOVER_MODE=real
# PIPELINE_SPOOL_ROOT='/var/lib/data-mover/spool'
# PIPELINE_ALLOWED_HTTPS_HOSTS='mss.example.gov,mcscop.example.gov'
# PIPELINE_CA_BUNDLE='deployment/pipeline-ca.pem'
# PIPELINE_ENABLE_POSTGRES_WRITER=true
# PIPELINE_ENABLE_MSS_WRITER=false
# PIPELINE_ENABLE_MCSCOP_WRITER=false
# PIPELINE_APPLY_INTERNAL_CA_FIX=false

# =============================================================================
# 3) PROVISIONING HELPERS — used by deployment scripts, never read by the app
# =============================================================================
# The app reads DATABASE_URL. These values are only convenient inputs for the
# PostgreSQL creation helper in docs/deploy.md.
# DB_NAME=data_mover
# DB_USER=data_mover
# DB_PASSWORD='REPLACE_WITH_DATABASE_PASSWORD'
# DB_HOST='postgres.example.gov'
# DB_PORT=5432
# DB_ADMIN_DATABASE=postgres
# DB_SSLMODE=require

# =============================================================================
# 4) OPTIONAL LOCAL POSIT WORKBENCH DOCKER TESTS
# =============================================================================
# POSIT_WORKBENCH_KEY='XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX'
# PWB_IMAGE=posit/workbench:latest
# PWB_HOST_PORT=8787
# APP_HOST_PORT=8000
# PWB_TESTUSER=posit
# PWB_TESTUSER_PASSWD='REPLACE_WITH_TEST_PASSWORD'
# ADMIN_EMAIL=admin@example.gov
# ADMIN_BOOTSTRAP_PASSWORD='REPLACE_WITH_TEST_PASSWORD'
