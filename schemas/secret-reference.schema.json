{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/data-mover/secret-reference.schema.json",
  "title": "Data Mover secret reference",
  "description": "An opaque pointer to an owner-scoped secret. Plaintext secret values are forbidden.",
  "type": "object",
  "required": ["secret_ref"],
  "additionalProperties": false,
  "properties": {
    "secret_ref": {
      "type": "object",
      "required": ["id", "provider", "context", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,119}$",
          "description": "Opaque reference identifier; never a credential value."
        },
        "provider": {
          "type": "string",
          "enum": ["postgres", "mss", "mcscop", "csv"]
        },
        "context": {
          "type": "string",
          "enum": ["pipeline:run", "pipeline:plan", "report:metadata"]
        },
        "version": {
          "type": "string",
          "pattern": "^(current|[A-Za-z0-9._:-]{1,64})$"
        }
      }
    }
  }
}
